# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a git.

DATABASE_URL=postgresql://usuario:contraseña@host:5432/lucyscan_db
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
AUTH_URL=https://lucyscan.com
NEXTAUTH_URL=https://lucyscan.com
AI_API_URL=http://tu-servidor-ai:8100
API_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio

# Resend — para envío de emails (reset de contraseña, notificaciones)
# Obtén tu API key en https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
